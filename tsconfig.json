{
  "compilerOptions": {
    "strict": true,
    "types": [
      "bun"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "skipLibCheck": true,
    "noEmit": true,
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "scripts"
  ]
}
